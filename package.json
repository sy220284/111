{
  "name": "claude-code-2.1.310-source-restoration-v3",
  "version": "2.1.310",
  "private": true,
  "type": "module",
  "description": "Claude Code 2.1.310 reconstructed JS modules and complete recovered 250 embedded resources (partial Bun/JSC runtime parity)",
  "engines": {
    "node": ">=22.16.0"
  },
  "scripts": {
    "check:source": "node --no-warnings --experimental-vm-modules tests/check-source.cjs",
    "check:version": "node tests/smoke-version.cjs",
    "test": "npm run check:source && npm run check:embedded && npm run check:resource-map && npm run check:hooks && npm run check:native-audio && npm run check:js-bundles && npm run check:assets && npm run check:version && npm run check:plugin-kit && npm run check:function-hooks-worker && npm run check:streaming-tool-contract",
    "check:embedded": "node tests/check-embedded.cjs",
    "check:assets": "node --test tests/runtime-assets.test.mjs",
    "start": "node bin/claude-310.mjs",
    "verify:runtime": "node bin/claude-310.mjs --help",
    "check:resource-map": "node scripts/build-resource-consumers.cjs --check",
    "check:hooks": "node --test tests/hooks-source-restoration.test.cjs",
    "audit:functions": "node scripts/source-function-index.cjs --check",
    "rebuild:functions": "node scripts/source-function-index.cjs --full",
    "check:js-bundles": "node --test tests/js-resource-loader.test.mjs",
    "check:native-audio": "node --test tests/native-audio-source.test.cjs",
    "generate:functions": "node scripts/source-function-index.cjs --full",
    "check:plugin-kit": "node --no-warnings --experimental-vm-modules --test tests/plugin-kit-source.test.cjs",
    "restore:plugin-kit": "node scripts/restore-plugin-testing-kit.cjs",
    "check:function-hooks-worker": "node --test tests/function-hook-worker-contract.test.cjs",
    "check:streaming-tool-contract": "node --test tests/streaming-tool-contract.test.cjs"
  },
  "dependencies": {
    "ws": "8.22.0"
  },
  "os": [
    "linux"
  ],
  "cpu": [
    "x64"
  ],
  "bin": {
    "claude-310-source": "./bin/claude-310.mjs"
  },
  "files": [
    "bin/",
    "src/",
    "runtime/",
    "resources/",
    "tests/",
    "scripts/",
    "README.md",
    "package.json"
  ]
}
