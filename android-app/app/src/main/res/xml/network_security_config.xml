<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- On-device Codex uses stdio. All app-initiated remote traffic requires TLS. -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
